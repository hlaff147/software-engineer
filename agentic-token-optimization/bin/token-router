#!/usr/bin/env bash
# ==============================================================================
# bin/token-router
# Executável wrapper universal para o Token Router
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

export PYTHONPATH="$ROOT_DIR/src:${PYTHONPATH:-}"

exec python3 -m token_router.cli "$@"
